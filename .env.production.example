# ─── Production Environment Variables ──────────────────────────
# Copy to .env.production and fill in values
# Generate keys with: openssl rand -hex 32

# Server
NODE_ENV=production
PORT=3001

# Database (use RDS endpoint in production)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/wholeness_grace

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-char-random-hex
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Data Encryption (AES-256-GCM — must be 64 hex chars)
DATA_ENCRYPTION_KEY=replace-with-64-char-hex-key

# CORS
FRONTEND_URL=https://app.your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AWS (optional, for S3 file storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET=wholeness-grace-uploads